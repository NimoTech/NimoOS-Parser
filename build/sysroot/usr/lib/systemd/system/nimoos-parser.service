[Unit]
Description=NimoOS Parser
Documentation=https://github.com/NimoTech/NimoOS-Parser
# qdrant 以 docker 容器运行(无 qdrant.service),排序锚点是 docker.service;
# 与 118 现役 unit 对齐,消除"模板 vs 真机"漂移。
After=docker.service nimoos-wiki.service nimoos-message-bus.service
Wants=docker.service

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/opt/nimoos-parser
Environment=PYTHONPATH=/opt/nimoos-parser
Environment=PARSER_DISCOVERY_FILE=/var/run/nimoos/parser.url
Environment=PARSER_BIND_ADDR=127.0.0.1:8283
Environment=HF_HOME=/opt/nimoos-parser/hf-cache
# glibc 每线程 arena 会放大 Python/torch 的 RSS 碎片滞留,限 2 个足够
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/nimoos-parser/venv/bin/python -m uvicorn parser.main:app --host 127.0.0.1 --port 8283
# 内存兜底(2026-07-28 全局 OOM 复盘,specs/2026-07-28-memory-management-design.md):
# parser 常驻 bge-m3/reranker/docling/VLM 四组模型,正常峰值 <8G;
# MemoryHigh 触顶先由 cgroup 施加回收压力,MemoryMax 硬杀只波及本服务;
# MemorySwapMax 防止泄漏进程靠 swap 苟活拖垮全机(当时 parser 占了 6.3G swap);
# Restart=always 保证内存自愈退出(M3)与 cgroup kill 后都能拉起;
# OOMScoreAdjust=500:万一仍走到内核全局 OOM,优先杀 ML 服务而非 gateway/core。
MemoryAccounting=yes
MemoryHigh=8G
MemoryMax=10G
MemorySwapMax=2G
OOMScoreAdjust=500
Restart=always
RestartSec=10s
# 首装/冷缓存时 HF 模型下载可能远超默认 90s(118 现役值,合入模板防漂移)
TimeoutStartSec=1800
TimeoutStopSec=30
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nimoos-parser

[Install]
WantedBy=multi-user.target
