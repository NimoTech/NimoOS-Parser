[Unit]
Description=NimoOS Parser
Documentation=https://github.com/NimoTech/NimoOS-Parser
# qdrant runs as a docker container (no qdrant.service), so the ordering
# anchor is docker.service; kept aligned with the live unit on 118 to
# eliminate "template vs real machine" drift.
After=docker.service nimoos-wiki.service nimoos-message-bus.service
Wants=docker.service

[Service]
Type=notify
User=root
Group=root
WorkingDirectory=/opt/nimoos-parser
Environment=PYTHONPATH=/opt/nimoos-parser
Environment=PARSER_DISCOVERY_FILE=/var/run/nimoos/parser.url
Environment=PARSER_BIND_ADDR=127.0.0.1:8283
Environment=HF_HOME=/opt/nimoos-parser/hf-cache
# glibc's per-thread arenas amplify RSS fragmentation left over from Python/torch; capping at 2 is enough
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/nimoos-parser/venv/bin/python -m uvicorn parser.main:app --host 127.0.0.1 --port 8283
# Memory backstop (postmortem of the 2026-07-28 global OOM,
# specs/2026-07-28-memory-management-design.md): parser keeps four model
# groups resident (bge-m3/reranker/docling/VLM); on 118 a single measured
# caption run (VLM 5.6G + bge-m3 2.3G + base) already hits 8.6G, and with
# docling overlapping the legitimate peak is ~11G. High/Max must leave
# generous headroom rather than being set to an "ideal steady state", or
# normal load gets killed by mistake. MemoryHigh applies cgroup reclaim
# pressure once hit; MemoryMax hard-kills but only affects this service.
# MemorySwapMax stops a leaking process limping along on swap and dragging
# down the whole machine (parser was using 6.3G of swap at the time).
# Restart=always ensures a restart both after the memory self-heal exit (M3)
# and after a cgroup kill. OOMScoreAdjust=500: if it still escalates to a
# kernel-wide OOM, prefer killing ML services over gateway/core.
MemoryAccounting=yes
MemoryHigh=10G
MemoryMax=12G
MemorySwapMax=2G
OOMScoreAdjust=500
Restart=always
RestartSec=10s
# On first install / cold cache, the HF model download can far exceed the default 90s (value live on 118, merged into the template to prevent drift)
TimeoutStartSec=1800
TimeoutStopSec=30
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nimoos-parser

[Install]
WantedBy=multi-user.target
